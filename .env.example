# Generative AI API Keys (Optional for live LLM execution; fallback mode active by default)
# Add your Google Gemini API key or OpenAI API key below if live generation is desired:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Optional for MySQL live connections)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_sales_analytics
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Security Note: NEVER commit your actual .env file with real credentials to GitHub!
